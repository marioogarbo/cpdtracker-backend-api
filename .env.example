# Django Settings
DEBUG="false"
DJANGO_SECRET_KEY="your-secret-key-here"
CLOUDRUN_SERVICE_URLS="https://your-backend-url.run.app"

# Database Configuration
POSTGRES_DB="your-database-name"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-database-password"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"

# Redis Configuration (Optional - for production caching)
# REDIS_URL="redis://127.0.0.1:6379"

# Google OAuth
GOOGLE_OAUTH_KEY="your-google-oauth-client-id"
GOOGLE_OAUTH_SECRET_KEY="your-google-oauth-secret"

# Microsoft OAuth
MICROSOFT_OAUTH_KEY="your-microsoft-oauth-client-id"
MICROSOFT_OAUTH_SECRET_KEY="your-microsoft-oauth-secret"

# Frontend URLs
REDIRECT_URLS="https://your-frontend-url.run.app/auth/google,https://your-frontend-url.run.app/auth/microsoft"

# Email Configuration
PASSWORD_RESET_CONFIRM_URL="auth/reset-password/{uid}/{token}"
ACTIVATION_URL="auth/activation/{uid}/{token}"
EMAIL_FRONTEND_SITE_NAME="CPD Auto"
EMAIL_FRONTEND_DOMAIN="your-frontend-domain"
EMAIL_HOST="smtp.gmail.com"
EMAIL_HOST_USER="your-email@gmail.com"
EMAIL_HOST_PASSWORD="your-app-password"
DEFAULT_FROM_EMAIL="noreply@example.com"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
STRIPE_SUCCESS_URL="https://your-frontend-url.run.app/subscriptions/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="https://your-frontend-url.run.app/subscriptions/cancel?canceled=true"

# Azure OpenAI Configuration
AZURE_OPENAI_DEPLOYMENT_MODEL="gpt-4"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"

# Axcelerate API Configuration
AXCELERATE_BASE_URL="https://stg.axcelerate.com/api"
AXCELERATE_WSTOKEN="your-axcelerate-ws-token"
AXCELERATE_APITOKEN="your-axcelerate-api-token"
